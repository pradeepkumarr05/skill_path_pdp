# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---------------------------------------------------------
# postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://skillpath:skillpath@localhost:5432/skillpath
# Set to "true" only if your provider requires SSL (e.g. most managed
# cloud Postgres services) with a self-signed/managed certificate.
PGSSL=false
PG_POOL_MAX=10

# --- Auth ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-64+-character-string

# --- App -------------------------------------------------------------
NODE_ENV=development
API_PORT=8787
# Must match the origin the frontend is served from (CORS + cookie scoping).
CLIENT_ORIGIN=http://localhost:5173

# --- Google Sign-In ------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, with
# http://localhost:5173 added as an Authorized JavaScript origin.
# Same value goes in both of these - GOOGLE_CLIENT_ID is read by the
# backend to verify tokens; VITE_GOOGLE_CLIENT_ID is baked into the
# frontend build so the "Sign in with Google" button can initialize.
# Leave both blank to leave Google Sign-In disabled.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- GitHub Sign-In --------------------------------------------------------
# Create an OAuth App at https://github.com/settings/developers
# ("New OAuth App"). Set "Authorization callback URL" to exactly
# GITHUB_CALLBACK_URL below (must match GitHub's dashboard exactly,
# including http/https and trailing path).
# Leave blank to leave the GitHub button disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8787/api/auth/github/callback

# Encryption key for the stored GitHub access token (optional - only used
# if you later call the GitHub API on the user's behalf). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank to skip storing the token (sign-in itself still works).
ENCRYPTION_KEY=

# --- Email (forgot-password OTPs) -----------------------------------------
# Any standard SMTP provider works (Gmail app password, SendGrid, Mailgun,
# Postmark, Amazon SES SMTP, etc). Leave these blank in local development -
# the 6-digit code will be printed to the server console instead of
# emailed, so you can still test the flow end-to-end.
SMTP_HOST=
SMTP_PORT=587
# "true" only for port 465 (implicit TLS). Leave "false" for 587/25, which
# use STARTTLS instead.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SkillPath <no-reply@example.com>

# --- Gemini (pre-existing, unrelated to auth) ---------------------------
# GEMINI_API_KEY=
