# SkillPath — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is git-ignored and must NEVER be committed.

# ── Gemini AI ────────────────────────────────────────────────────────────────
# Obtain from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
CLIENT_ORIGIN=http://localhost:5173
# Only for offline development: explicitly allows question-bank/heuristic fallback.
ALLOW_DETERMINISTIC_AI_FALLBACK=false

# Optional: override the model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Full connection string including database name.
# Example (local):    postgresql://postgres:password@localhost:5432/skillpath
# Example (Neon):     postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/skillpath?sslmode=require
# Example (Supabase): postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/skillpath

# ── JWT ──────────────────────────────────────────────────────────────────────
# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# ── Server ────────────────────────────────────────────────────────────────────
# Port for the Node.js API server (default: 8787)
# API_PORT=8787
